# Default: ignore everything at the repo root
/*

# ===== Top-level allowlist =====
!/.audit-ignore
!/.gitignore
!/.gitmodules
!/.markdownlint-cli2.yaml
!/.profile
!/.tmux.conf
!/.bash_profile
!/.bashrc
!/.zprofile
!/.zshrc
!/AGENTS.md
!/CLAUDE.md
!/LICENSE
!/README.md
!/bin/
!/commitCheck.sh
!/git-hooks/
!/keychron/
!/misc/
!/test/
!/zshfunctions

# ===== Dotted config trees: re-open, then curate inside =====
!/.claude/
!/.codex/
!/.config/
!/.hermes/
!/.pi/

# --- .claude/: allow only known entries ---
/.claude/*
!/.claude/CLAUDE.md
!/.claude/README.md
!/.claude/agents/
!/.claude/commands/
!/.claude/hooks/
!/.claude/output-styles/
!/.claude/plugins/
!/.claude/settings.json
!/.claude/skills/
!/.claude/statusline-command.sh

# Inside .claude/plugins/: only config.json. installed_plugins.json is install
# state Claude Code rewrites; enabledPlugins in settings.json is the source
/.claude/plugins/*
!/.claude/plugins/config.json

# Inside .claude/skills/: claude.ai skill sync writes Anthropic-licensed
# skills here; not ours to publish
/.claude/skills/synced/

# --- .codex/: allow durable config and user-managed content only ---
# config.toml is not tracked: Codex rewrites it with marketplace stamps,
# per-directory trust and app state, which outweigh the settings in it
/.codex/*
!/.codex/AGENTS.md
!/.codex/hooks.json
!/.codex/rules/
!/.codex/skills/

# Inside .codex/rules/: allow rule files
/.codex/rules/*
!/.codex/rules/**/*.rules
!/.codex/rules/**/*.md

# Inside .codex/skills/: allow user-managed skills, not bundled/runtime skills
/.codex/skills/*
!/.codex/skills/**
/.codex/skills/.system/
/.codex/skills/.system/**
/.codex/skills/codex-primary-runtime/
/.codex/skills/codex-primary-runtime/**

# --- .config/: allow specific tool dirs ---
/.config/*
!/.config/atuin/
!/.config/bat/
!/.config/btop/
!/.config/caveman/
!/.config/cmux/
!/.config/codeburn/
!/.config/espanso/
!/.config/gh/

!/.config/gh-copilot/
!/.config/gh-txplabs/
!/.config/ghostty/
!/.config/git/
!/.config/helix/
!/.config/herdr/
!/.config/ideavim/
!/.config/jj/
!/.config/lazydocker/
!/.config/lazygit/
!/.config/lazysql/
!/.config/leaf/
!/.config/lf/
!/.config/lsd/
!/.config/mise/
!/.config/nvim/
!/.config/opencode/
!/.config/pgcli/
!/.config/ranger/
!/.config/superfile/
!/.config/wezterm/
!/.config/wtf/
!/.config/yazi/
!/.config/zed/
!/.config/zennotes/

# Inside .config/herdr/: only config, not sockets/logs
/.config/herdr/*
!/.config/herdr/config.toml

# Inside .config/opencode/: nothing is tracked
/.config/opencode/*

# Inside .config/superfile/: only config, not the bundled themes
/.config/superfile/*
!/.config/superfile/config.toml
!/.config/superfile/hotkeys.toml

# Noise inside otherwise-allowed config dirs
/.config/pgcli/history
/.config/pgcli/log
/.config/zed/.tmp*
/.config/zed/conversations
/.config/zed/prompts
/.config/zed/settings_backup.json
# Compiled from spell/*.add at nvim startup (see lua/config/options.lua)
/.config/nvim/spell/*.spl

# --- .hermes/: only curated config ---
/.hermes/*
!/.hermes/config.yaml
!/.hermes/SOUL.md

# --- .pi/: only the agent tree ---
/.pi/*
!/.pi/agent/
/.pi/agent/auth.json
/.pi/agent/sessions/
/.pi/agent/mcp-oauth/
/.pi/agent/mcp-cache.json
/.pi/agent/mcp-npx-cache.json
/.pi/agent/mcp-onboarding.json
/.pi/agent/fff/
# Runtime state: provider model cache, per-machine trust, per-session cursors
/.pi/agent/models-store.json
/.pi/agent/trust.json
/.pi/agent/pi-blackhole/*-pending*.json

# ===== Depth-agnostic noise =====
*.lock
*.log
*.bak
.DS_Store
**/lazy-lock.json
!/.config/nvim/lazy-lock.json
**/packer_compiled.lua
**/__pycache__/
*.pyc
.todos/
