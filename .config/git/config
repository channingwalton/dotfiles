[fetch]
 prune = true

[filter "lfs"]
  clean = git-lfs clean -- %f
  smudge = git-lfs smudge -- %f
  process = git-lfs filter-process
  required = true

[user]
  name = Channing Walton
  email = channingwalton@mac.com

[core]
  excludesfile = ~/.config/git/gitignore_global
  autocrlf = input

[credential]
  helper = osxkeychain

[diff]
  tool = difftastic

[difftool]
  prompt = false

[difftool "difftastic"]
  cmd = difft "$LOCAL" "$REMOTE"

[pager]
  difftool = true

[pull]
  rebase = false

[http]
  postBuffer = 100000000

[init]
  defaultBranch = main

[push]
  autoSetupRemote = true

[mergetool]
  prompt = false

# Keep this last. The TXP file's empty `helper =` clears every credential helper
# set before it, including osxkeychain above; with osxkeychain still in the list,
# git stored the TXP token there and overwrote the personal GitHub login.
[includeIf "gitdir:/Users/channing/dev/TXPLabs/**"]
  path = /Users/channing/dev/TXPLabs/gitconfig

