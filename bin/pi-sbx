#!/usr/bin/env bash
# pi-sbx: run pi in a Docker Sandbox (sbx) microVM.
#
# Usage: pi-sbx [DIR] [-- PI_ARGS...]
#
# - Mounts DIR (default: the current directory) as the workspace. Refuses
#   $HOME, its parents, and anything inside or containing ~/.pi or ~/.agents.
# - Copies ~/.pi and ~/.agents into the sandbox home (/home/agent),
#   excluding credential-looking files, MCP OAuth state, session history
#   and host package installations (Git checkouts, npm state and node_modules).
# - Reuses one sandbox per directory, and replaces the config copy on every
#   run, keeping the sandbox's own logins, sessions and packages.
# - Passes everything after -- through to pi.
#
# One-time prerequisites:
#   brew install docker/tap/sbx
#   sbx login
#   sbx policy init balanced
set -euo pipefail

KIT="docker.io/sbx/pi-kit:latest"
SANDBOX_HOME="/home/agent"

die() {
  printf 'pi-sbx: %s\n' "$*" >&2
  exit 1
}
warn() { printf 'pi-sbx: warning: %s\n' "$*" >&2; }
usage() {
  cat <<'EOF'
Usage: pi-sbx [DIR] [-- PI_ARGS...]

  DIR      directory to mount as the workspace (default: current directory)
  -- ...   everything after -- is passed through to pi
EOF
}

dir=""
pi_args=()
while (($#)); do
  case "$1" in
  -h | --help)
    usage
    exit 0
    ;;
  --)
    shift
    pi_args=("$@")
    break
    ;;
  -*) die "unknown option: $1 (pi arguments go after --)" ;;
  *)
    [[ -z "$dir" ]] || die "unexpected argument: $1 (pi arguments go after --)"
    dir=$1
    shift
    ;;
  esac
done

command -v sbx >/dev/null || die "sbx not found. Install it with: brew install docker/tap/sbx"

physical() { CDPATH='' cd -- "$1" && pwd -P; }

# within PATH DIR: PATH is DIR or below it. PATH must be physical. -ef compares
# device and inode, so neither a symlink (~/.pi into dotfiles, say) nor letter
# case (APFS is case-insensitive by default, and `pwd -P` keeps the case as
# typed) can disguise the relationship the way a string prefix can.
within() {
  local path=$1
  [[ $path == /* ]] || return 1 # dirname never reaches / from a relative path
  while :; do
    [[ $path -ef $2 ]] && return 0
    [[ $path == / ]] && return 1
    path=$(dirname -- "$path")
  done
}

dir=${dir:-.}
[[ -d "$dir" ]] || die "no such directory: $dir"
workdir="$(physical "$dir")"
home="$(physical "$HOME")" # its own line, so set -e stops on an unresolvable HOME

if within "$home" "$workdir"; then
  die "refusing to mount $workdir; pick a project directory"
fi
for config in "$HOME/.pi" "$HOME/.agents"; do
  [[ -d "$config" ]] || continue
  config="$(physical "$config")"
  within "$workdir" "$config" && die "refusing to mount an agent config directory"
  within "$config" "$workdir" && die "refusing to mount $workdir; it contains $config"
done

# Sandbox name: pi-<dir>-<hash of full path>.
# sbx allows letters, digits, hyphens and periods.
base="$(printf '%s' "$(basename "$workdir")" | tr -c 'A-Za-z0-9.-' '-' | cut -c1-40)"
hash="$(printf '%s' "$workdir" | shasum | cut -c1-6)"
name="pi-${base:-dir}-${hash}"

# Create the sandbox on first use in this directory.
if ! sbx ls 2>/dev/null | grep -qF -- "$name"; then
  sbx create --name "$name" "$KIT" "$workdir"
fi

# Copy config into the sandbox home, replacing the last run's copy so
# files deleted or renamed here don't linger there.
# find chooses the entries and tar -n archives just those, so the
# credential patterns only match file names and never drop a directory
# such as skills/authoring. Log in once inside the sandbox instead.
# skip matches what the copy leaves out. Clearing leaves the sandbox's
# own copies of those alone, so its logins, sessions and packages survive.
# The extracting tar runs as the sandbox's default user, so the files
# are owned by that user, not root.
# Include descendants so exclusions also apply to the depth-first cleanup,
# where -prune cannot prevent traversal.
skip=(
  \( -name node_modules -o -path '*/node_modules/*'
  -o -path .pi/agent/git -o -path '.pi/agent/git/*'
  -o -path .pi/agent/npm -o -path '.pi/agent/npm/*'
  -o -path .pi/agent/sessions -o -path '.pi/agent/sessions/*'
  -o -path .pi/agent/mcp-oauth -o -path '.pi/agent/mcp-oauth/*' \) -prune -o
  ! -type d \( -name .DS_Store -o -iname '*auth*' -o -iname 'credential*'
  -o -iname '*token*' -o -iname '*.key' -o -iname '*.pem' \) -o
)
# Runs in the sandbox home, with skip as its arguments.
# shellcheck disable=SC2016 # expands in the sandbox, not here
refresh='
  set -euo pipefail
  dirs=()
  for d in .pi .agents; do [[ -d $d ]] && dirs+=("$d"); done
  if ((${#dirs[@]})); then
    find "${dirs[@]}" "$@" ! -type d -exec rm -f -- {} +
    find "${dirs[@]}" -depth "$@" -type d -empty -delete
  fi
  tar --warning=no-unknown-keyword -xf -
'
sources=()
[[ -d "$HOME/.pi" ]] && sources+=(.pi)
[[ -d "$HOME/.agents" ]] && sources+=(.agents)

if [[ -f "$HOME/.pi/agent/models.json" ]] && grep -q '"apiKey"' "$HOME/.pi/agent/models.json"; then
  warn "$HOME/.pi/agent/models.json contains apiKey fields; any literal keys will be copied into the sandbox"
fi

# An empty source list produces an empty archive, but still clears stale config.
(
  cd "$HOME"
  if ((${#sources[@]})); then
    find -L "${sources[@]}" "${skip[@]}" \( -type d -o -type f \) -print0
  fi
) |
  COPYFILE_DISABLE=1 tar -C "$HOME" -c -h -n --no-mac-metadata --null -T - -f - |
  sbx exec -i -w "$SANDBOX_HOME" "$name" bash -c "$refresh" bash "${skip[@]}"

if ((${#pi_args[@]})); then
  exec sbx run --name "$name" -- "${pi_args[@]}"
fi
exec sbx run --name "$name"
